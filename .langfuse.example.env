# ==================================================
# Langfuse Self-Hosted Configuration
# ==================================================
# Copy this file to `.langfuse.env` and replace all
# placeholder values before running the stack.
# ==================================================


# ==================================================
# PostgreSQL
# ==================================================
POSTGRES_DB=langfuse
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=change-me


# ==================================================
# ClickHouse
# ==================================================
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:change-me@clickhouse:9000
CLICKHOUSE_CLUSTER_ENABLED=false


# ==================================================
# MinIO (S3-Compatible Storage)
# ==================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me


# ==================================================
# Event Upload Storage
# ==================================================
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/


# ==================================================
# Langfuse Database
# ==================================================
DATABASE_URL=postgresql://langfuse:change-me@postgres:5432/langfuse


# ==================================================
# Authentication
# ==================================================
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-a-long-random-secret


# ==================================================
# Encryption
# ==================================================
SALT=generate-a-long-random-secret
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32


# ==================================================
# Redis
# ==================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=change-me